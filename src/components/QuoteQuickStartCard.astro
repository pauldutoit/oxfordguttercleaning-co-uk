---
import siteConfig from '../data/site.config.json';
---

<aside class="quick-start-card">
  <span class="quick-start-eyebrow">Free quotes in 60 seconds</span>
  <h2 class="quick-start-h">Compare 2-3 local specialists</h2>
  <p class="quick-start-lede">
    Vetted, insured and reviewed - competing for your job so you pay a fair local rate.
  </p>
  <a class="btn btn-accent quick-start-cta" href="/quote">Get my free quotes &rarr;</a>
  <ul class="quick-start-badges" aria-label="What we commit to">
    <li>&#10003; No cold calls</li>
    <li>&#10003; No obligation</li>
    <li>&#10003; 100% free for homeowners</li>
  </ul>
  {siteConfig.aggregateRating && (
    <p class="quick-start-rating">
      &#9733; <strong>{siteConfig.aggregateRating.value}/5</strong>
      <span>from {siteConfig.aggregateRating.count} reviews across the region</span>
    </p>
  )}
</aside>

<style>
  .quick-start-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem 1.5rem;
    background: #fff;
    border: 1px solid rgba(42, 54, 65, 0.12);
    border-radius: var(--radius-md, 10px);
    box-shadow: 0 8px 24px -12px rgba(42, 54, 65, 0.25);
  }
  .quick-start-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent, #b8722e);
  }
  .quick-start-h {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--color-primary, #2a3641);
  }
  .quick-start-lede {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: #4a5460;
  }
  .quick-start-cta {
    margin-top: 0.35rem;
    padding: 0.9rem 1.25rem;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .quick-start-badges {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.85rem;
    color: #556170;
  }
  .quick-start-badges li { margin: 0; }
  .quick-start-rating {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: #556170;
  }
  .quick-start-rating strong {
    color: var(--color-primary, #2a3641);
    margin-right: 0.35rem;
  }
</style>
